PORT=3000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/attendfix
#
# Supabase — use the "Transaction pooler" string (port 6543), NOT the direct string:
# Go to Supabase dashboard → Settings → Database → Connection string → Transaction pooler
# It looks like this (replace YOUR_PASSWORD):
DATABASE_URL=postgresql://postgres.yapenstileetvkdcsvkm:duweejx@gmail.com@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=replace_with_long_random_string_in_production

# ── Email (MR DIY SMTP) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.mrdiy.com
SMTP_PORT=587
SMTP_USER=no-reply@mrdiy.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=AttendFix <no-reply@mrdiy.com>

# ── App URL (used in email links) ─────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── HR System Integration ─────────────────────────────────────────────────────
# Set HR_ADAPTER=mock to use generated demo data (default)
# Set HR_ADAPTER=api  when you have the real HR system credentials
HR_ADAPTER=mock

# When HR_ADAPTER=api, fill these in:
# HR_API_URL=https://hr.mrdiy.com/api/v1
# HR_API_KEY=your_api_key_here
# HR_API_COMPANY_CODE=MRDIY

# ── Sync schedule (cron syntax, KL timezone) ──────────────────────────────────
# Default: pull from HR every day at 01:00, detect missing at 23:45
HR_SYNC_SCHEDULE=0 1 * * 1-6
MISSING_DETECT_SCHEDULE=45 23 * * 1-6
